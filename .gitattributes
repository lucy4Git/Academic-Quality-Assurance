# Normalize line endings to LF in the repository; auto-convert on checkout.
* text=auto eol=lf

# Explicitly binary — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.whl  binary
*.key  binary
*.pem  binary
*.pfx  binary
*.crt  binary
