# AQAA Staging Environment Variables
# ====================================
# Copy this file to backend/.env for local-against-cloud testing, or
# paste these values into Render / Vercel dashboard environment settings.
#
# NEVER commit a .env file with real values to source control.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(64))"

# --- Application ---
APP_ENV=staging
DEBUG=false

# --- Security ---
# Must be at least 32 random chars; known defaults are rejected in staging.
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Must be set in staging (protects /metrics endpoint)
METRICS_API_KEY=REPLACE_WITH_RANDOM_STRING

# --- Database (Neon PostgreSQL) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME?ssl=require
DATABASE_URL=postgresql+asyncpg://REPLACE@REPLACE.neon.tech/REPLACE?ssl=require

# --- Redis (Upstash) ---
# Format: rediss://default:TOKEN@HOSTNAME.upstash.io:PORT
# Note: rediss:// (double s) = TLS required by Upstash
REDIS_URL=rediss://default:REPLACE@REPLACE.upstash.io:6379

# --- Qdrant Cloud ---
QDRANT_URL=https://REPLACE.qdrant.io
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY

# --- Storage (Cloudflare R2) ---
STORAGE_BACKEND=s3
S3_BUCKET=aqaa-staging
S3_REGION=auto
# R2 endpoint: https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://REPLACE.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://REPLACE.vercel.app,http://localhost:3000

# --- AI Provider ---
# Set to LOCAL_DEV for staging without a real AI provider.
# Set to ANTHROPIC and provide ANTHROPIC_API_KEY for live AI features.
AI_PROVIDER=LOCAL_DEV
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email (optional — console mode if not set) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=REPLACE
# SMTP_FROM=noreply@REPLACE.ac.za
# SMTP_TLS=true

# --- Sentry (optional — disabled by default) ---
# SENTRY_ENABLED=true
# SENTRY_DSN=https://REPLACE@REPLACE.ingest.sentry.io/REPLACE
# SENTRY_ENVIRONMENT=staging

# --- Registration ---
REGISTRATION_OPEN=true
REGISTRATION_AUTO_APPROVE=false
