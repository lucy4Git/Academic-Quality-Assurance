# Backend-local environment template.
#
# `app/config.py` loads `Settings` with `env_file=".env"`, resolved relative
# to the current working directory -- i.e. this file must be copied to
# `backend/.env` when running the backend from the `backend/` directory
# (`uvicorn app.main:app --reload`, `pytest`, `alembic ...`).
#
#   cp .env.example .env
#
# Never commit the populated `.env`.
#
# These defaults assume the datastores from the root `docker-compose.yml`
# are running and have their ports published to localhost (the default).
# If the backend itself also runs inside docker-compose, it overrides
# DATABASE_URL / REDIS_URL / QDRANT_URL to use the in-network service
# hostnames (postgres / redis / qdrant) automatically -- see
# docker-compose.yml.

# --- Application ---
APP_NAME="Academic Quality Assurance Agent"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database (async driver: postgresql+asyncpg) ---
# Matches the default POSTGRES_USER/PASSWORD/DB in the root docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://aqaa:aqaa@localhost:5432/aqaa
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000

# --- AI Provider ---
# Set AI_PROVIDER to: LOCAL_DEV (default, no key needed) | OPENAI | ANTHROPIC | OLLAMA
AI_PROVIDER=LOCAL_DEV
DEFAULT_AI_PROVIDER=LOCAL_DEV
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024

# OpenAI — required if AI_PROVIDER=OPENAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ENABLE_OPENAI=false

# Anthropic — required if AI_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ENABLE_ANTHROPIC=false

# Google Gemini — required if AI_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI=false

# Ollama — required if AI_PROVIDER=OLLAMA (runs locally, no API key)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
ENABLE_OLLAMA=false

LOCAL_MODEL_PATH=

# --- File Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
VIRUS_SCAN_ENABLED=false
MAX_UPLOAD_SIZE_MB=50
