# Copy this file to `.env` (and to `backend/.env` if running the backend
# standalone) and fill in real values. Never commit the populated `.env`.

# --- Application ---
APP_NAME="Academic Quality Assurance Agent"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (async driver: postgresql+asyncpg) ---
DATABASE_URL=postgresql+asyncpg://aqaa:aqaa@localhost:5432/aqaa
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- docker-compose: Postgres container credentials ---
# Used by docker-compose.yml to initialize the `postgres` service. Keep these
# in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=aqaa
POSTGRES_PASSWORD=aqaa
POSTGRES_DB=aqaa
POSTGRES_PORT=5432

# --- Redis (caching, JWT revocation, background job state) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Qdrant (vector store for document embeddings / semantic search) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- docker-compose: backend container ---
BACKEND_PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000

# --- File Storage ---
# STORAGE_BACKEND: "local" (default) | "s3" | "azure" (s3/azure planned)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# Set true and configure your AV scanner when deploying to production
VIRUS_SCAN_ENABLED=false
MAX_UPLOAD_SIZE_MB=50
